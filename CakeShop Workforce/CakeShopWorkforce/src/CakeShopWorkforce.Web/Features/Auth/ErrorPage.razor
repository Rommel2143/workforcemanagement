@page "/error"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout

<PageTitle>Error · CakeShop Workforce</PageTitle>

<div class="login-page">
    <div class="login-card">
        <h1 class="login-heading">Something went wrong</h1>
        <p>An unexpected error happened. Please go back and try again. If it keeps happening, check the application log.</p>
        <a class="btn btn-primary" href="/">Back to the app</a>
    </div>
</div>
