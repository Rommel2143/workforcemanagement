@* Friendly message when there's nothing to show — always tell the user what to do next. *@

<div class="empty-state">
    <div class="empty-icon"><Icon Name="@Icon" Size="34" StrokeWidth="1.3" /></div>
    <div class="empty-title">@Title</div>
    @if (Message is not null)
    {
        <div class="empty-message">@Message</div>
    }
    @if (ChildContent is not null)
    {
        <div class="empty-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "info";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
