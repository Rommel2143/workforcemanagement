@* Dashboard tile: icon, label, big value and a small line underneath. Clickable when Href is set. *@

@if (Href is not null)
{
    <a class="kpi kpi-@Tone kpi-link" href="@Href" title="@Hint">@Body</a>
}
else
{
    <div class="kpi kpi-@Tone" title="@Hint">@Body</div>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Sub { get; set; }
    [Parameter] public string Icon { get; set; } = "chart";
    [Parameter] public string Tone { get; set; } = "brand";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Hint { get; set; }    // tooltip that explains the formula

    private RenderFragment Body => @<text>
        <div class="kpi-top">
            <span class="kpi-icon"><Icon Name="@Icon" Size="18" /></span>
            <span class="kpi-label">@Label</span>
            @if (Hint is not null)
            {
                <span class="kpi-hint"><Icon Name="info" Size="14" /></span>
            }
        </div>
        <div class="kpi-value">@Value</div>
        @if (Sub is not null)
        {
            <div class="kpi-sub">@Sub</div>
        }
    </text>;
}
