@*
    Simple outline icons (24×24, Fluent/Teams style strokes).
    Usage:  <Icon Name="calendar" />   <Icon Name="people" Size="20" />
    To add an icon: add a new entry to the Shapes dictionary below.
    Each entry is a list of shapes:
        "M3 3h18..."      → a path
        "circle:12,12,10" → a circle (cx, cy, r)
        "rect:3,4,18,18,2" → a rectangle (x, y, width, height, corner radius)
*@

<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @foreach (var shape in Shapes.GetValueOrDefault(Name, Shapes["dot"]))
    {
        if (shape.StartsWith("circle:"))
        {
            var c = shape[7..].Split(',');
            <circle cx="@c[0]" cy="@c[1]" r="@c[2]" />
        }
        else if (shape.StartsWith("rect:"))
        {
            var r = shape[5..].Split(',');
            <rect x="@r[0]" y="@r[1]" width="@r[2]" height="@r[3]" rx="@r[4]" />
        }
        else
        {
            <path d="@shape" />
        }
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "dot";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public double StrokeWidth { get; set; } = 1.6;
    [Parameter] public string? Class { get; set; }

