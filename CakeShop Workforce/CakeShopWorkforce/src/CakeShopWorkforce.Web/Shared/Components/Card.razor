@* White panel with an optional title row and action buttons on the right. *@

<section class="card @Class">
    @if (Title is not null || Actions is not null)
    {
        <header class="card-header">
            <div>
                @if (Title is not null)
                {
                    <h2 class="card-title">@Title</h2>
                }
                @if (Subtitle is not null)
                {
                    <div class="card-subtitle">@Subtitle</div>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="card-actions">@Actions</div>
            }
        </header>
    }
    <div class="card-body @(Flush ? "flush" : "")">
        @ChildContent
    </div>
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool Flush { get; set; }          // no padding (for tables)
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
